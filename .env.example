# Root-level env file consumed by docker-compose.yml (compose auto-loads a
# ".env" file next to it for ${VAR} substitution). Copy this to ".env" and fill
# it in — these credentials must match DB_USER / DB_PASSWORD in django/.env,
# since Django authenticates against MongoDB's "admin" database using those
# same values (see django/PomoTask/settings.py).
MONGO_INITDB_ROOT_USERNAME=
MONGO_INITDB_ROOT_PASSWORD=
MONGO_INITDB_DATABASE=pomotask
